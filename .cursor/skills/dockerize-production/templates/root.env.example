# ============ Vazin Edalat — production compose env (copy to .env, never commit .env) ============

# ---- Postgres (internal only) ----
POSTGRES_USER=vazin
POSTGRES_PASSWORD=CHANGE_ME_strong_random_32+chars
POSTGRES_DB=vazinedalat

# ---- Public URLs (baked into SPA builds) ----
PUBLIC_API_URL=https://api.vazinedalat.ir/api/v1
PUBLIC_ASSET_URL=https://api.vazinedalat.ir
PUBLIC_SITE_URL=https://vazinedalat.ir

# ---- Domains for Caddy (profile: edge) ----
SITE_DOMAIN=vazinedalat.ir
ADMIN_DOMAIN=admin.vazinedalat.ir
API_DOMAIN=api.vazinedalat.ir
ACME_EMAIL=ops@vazinedalat.ir

# ---- Host ports (skip Caddy → expose directly) ----
API_PORT=3000
WEB_PORT=8080
ADMIN_PORT=8081

# ---- Backend runtime (read by api service) ----
NODE_ENV=production
CORS_ORIGINS=https://vazinedalat.ir,https://admin.vazinedalat.ir
CORS_CREDENTIALS=true
JWT_ACCESS_SECRET=CHANGE_ME_openssl_rand_hex_32
JWT_REFRESH_SECRET=CHANGE_ME_openssl_rand_hex_32_different
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
OTP_TTL_SECONDS=120
THROTTLE_TTL=60000
THROTTLE_LIMIT=300
BODY_LIMIT=11534336
LOG_LEVEL=info
UPLOAD_MAX_FILE_SIZE=10485760
UPLOAD_ALLOWED_MIME_TYPES=application/pdf,image/jpeg,image/png,image/webp,application/zip,application/x-zip-compressed
SYSTEM_LOG_RETENTION_DAYS=7
DISCOUNT_RETENTION_DAYS=7

# ---- Build metadata (optional) ----
GIT_SHA=
APP_VERSION=
