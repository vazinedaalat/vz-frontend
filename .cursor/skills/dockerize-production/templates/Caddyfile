# Caddy — automatic HTTPS (Let's Encrypt), HTTP→HTTPS redirect, security headers
# Domains/email come from .env via compose environment.

{
	email {$ACME_EMAIL}
	servers {
		protocols h1 h2 h3
	}
}

(security) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
	encode zstd gzip
}

# ---- Client site ----
{$SITE_DOMAIN} {
	import security
	reverse_proxy web:8080
}

# ---- Admin panel ----
{$ADMIN_DOMAIN} {
	import security
	header X-Frame-Options "DENY"
	reverse_proxy admin:8080
}

# ---- API + uploads ----
{$API_DOMAIN} {
	import security
	request_body {
		max_size 12MB
	}
	reverse_proxy api:3000 {
		header_up X-Real-IP {remote_host}
	}
}
