# API (NestJS — include /v1)
VITE_API_URL=http://localhost:3000/api/v1

# Static uploads host (no /api prefix)
VITE_ASSET_BASE_URL=http://localhost:3000

# App
# development | staging | production
VITE_APP_ENV=development
VITE_APP_NAME=وزین عدالت

# true = use local mock datasets (never in production builds)
VITE_USE_MOCK=false

# Public site origin for canonical / Open Graph / JSON-LD (no trailing slash)
VITE_SITE_URL=https://vazinedalat.ir

# Note: Never put real secrets in VITE_* variables.
# They are exposed to the client.
